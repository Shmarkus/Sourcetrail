<?xml version="1.0" encoding="utf-8"?>
<config>
    <source_groups>
        <source_group_cli_maven>
            <name>CLI Maven regression</name>
            <type>Java Source Group from Maven</type>
            <status>enabled</status>
            <java_standard>21</java_standard>
            <source_extensions><source_extension>.java</source_extension></source_extensions>
            <maven>
                <project_file_path>pom.xml</project_file_path>
                <should_index_tests>1</should_index_tests>
            </maven>
        </source_group_cli_maven>
    </source_groups>
    <version>8</version>
</config>
